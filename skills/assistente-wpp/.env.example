# assistente-wpp: configuração privada. Fica em ~/.assistente-wpp/assistente.env
# (Windows: %USERPROFILE%\.assistente-wpp\assistente.env; Mac: ~/.assistente-wpp/assistente.env) e nunca vai para o Git.
# O jeito fácil de preencher é pedir ao Claude: "configure meu assistente de WhatsApp".

# Nome que você deu ao seu assistente (2 a 24 letras). Ele assina toda mensagem como *Nome:*.
ASSISTENTE_NOME=
# Seu nome, como o time te chama ("assistente virtual do <dono>").
ASSISTENTE_DONO=
# JID da sua conta no app WhatsApp MCP (linked_jid). `assistente.ps1 setup -Jid auto` preenche.
# Sem ele, o assistente não envia nada (falha fechada).
ASSISTENTE_CONTA_JID=
# Para onde vão os avisos a você. Vazio = a sua conversa consigo mesmo ("Você" no WhatsApp).
# O app WhatsApp MCP v1.5.0 recusa enviar para a própria conta: nesse caso, use outro número seu. O que você
# escrever de lá (ou do seu número, nessa conversa) é tratado como pedido seu.
ASSISTENTE_AVISO_JID=
# responder = responde sozinho ao time (padrão) | triagem = só lê, resume e leva a você.
ASSISTENTE_AUTONOMIA=responder
# Gênero do assistente, opcional: feminino | masculino | vazio (neutro). Só muda a concordância ("obrigada"/"obrigado").
ASSISTENTE_GENERO=
# Fuso dos horários nos avisos a você. O time trabalha em GMT-3; vazio = GMT-3.
# Aceita GMT-3, UTC+1, GMT+5:30 ou um id do Windows (ex.: "GMT Standard Time", com horário de verão).
ASSISTENTE_FUSO=GMT-3
# Fuso de trabalho do time (padrão GMT-3). Mensagens ao time saem nele.
ASSISTENTE_FUSO_TIME=GMT-3
# Minutos de silêncio numa conversa depois que você mesmo escreveu nela (padrão 15).
ASSISTENTE_ESPERA_MIN=15

# App WhatsApp MCP (https://github.com/BrOrlandi/whatsapp-mcp-local). Porta padrão 47821.
ASSISTENTE_MCP_URL=http://127.0.0.1:47821/mcp
# Só se você ligou o token no app (whatsapp-mcp token new).
ASSISTENTE_MCP_TOKEN=
# Webhook do app (opcional): o detector responde na hora em vez de esperar a consulta a cada 30 s. Escolha uma porta
# livre, cadastre no app em Configurações › Webhooks o endereço http://127.0.0.1:<porta>/ e cole aqui a chave que o
# app mostrar. Sem os dois, o detector segue só na consulta periódica.
ASSISTENTE_WEBHOOK_PORTA=
ASSISTENTE_WEBHOOK_SEGREDO=

# Arquivos privados (vazio = o padrão dentro de ~/.assistente-wpp/).
ASSISTENTE_EQUIPE=
ASSISTENTE_PERSONA=
ASSISTENTE_STATE_DIR=

# Aviso de sessão: quando uma sessão sua do Claude Code para e espera você (turno longo, autorização ou
# pergunta), o assistente avisa na conversa de avisos com um jeito de voltar a ela.
# 1 = ligado (padrão) | 0 = desligado
ASSISTENTE_AVISO_SESSAO=1
# Só avisa turnos com pelo menos estes segundos.
ASSISTENTE_AVISO_MIN_SEG=60
# Onde você programa: auto (detecta) | vscode | cli | t3
ASSISTENTE_AVISO_EDITOR=auto
# Link próprio para abrir a sessão, se o seu app tiver um ({session} e {cwd} são substituídos). Vazio = padrão.
ASSISTENTE_AVISO_LINK=

# Despachante: abre o Claude sem tela a cada lote de mensagens.
# Pasta de trabalho do Claude despachado (ex.: a pasta onde ficam os seus repositórios).
ASSISTENTE_PASTA_TRABALHO=
# auto = --permission-mode auto | lista = só as ferramentas necessárias (--allowedTools)
ASSISTENTE_CLAUDE_PERMISSAO=auto
# Argumentos extras para o Claude despachado, separados por espaço (ex.: --model sonnet).
ASSISTENTE_CLAUDE_ARGS=
# Caminho do claude.exe, se não estiver em ~/.local/bin nem no PATH.
ASSISTENTE_CLAUDE_EXE=
# 0 = desliga o despachante (o vigia não sobe).
ASSISTENTE_DESPACHANTE=1

# Voz (opcional): o assistente responde em áudio a quem mandou áudio, ou quando pedem. Usa a ElevenLabs
# (https://elevenlabs.io). Vazio = só texto. A chave é sua e fica só aqui.
ELEVENLABS_API_KEY=
# Voz: o id ou o link dela na ElevenLabs (`assistente.ps1 setup -VozId <link>`). Vazio = uma voz padrão pelo gênero
# do assistente (Sarah, Eric ou River, que funcionam em qualquer plano). Para vozes brasileiras:
# `assistente.ps1 vozes` (as da biblioteca podem exigir plano pago).
ASSISTENTE_VOZ_ID=
# Modelo (padrão eleven_multilingual_v2, que fala português).
ASSISTENTE_VOZ_MODELO=
# Ajuste fino (vazio = padrão da voz): estabilidade, similaridade e estilo de 0 a 1; velocidade ~0.7 a 1.2.
# Um ponto de partida natural: 0.30 / 0.80 / 0.45 / 1.08.
ASSISTENTE_VOZ_ESTABILIDADE=
ASSISTENTE_VOZ_SIMILARIDADE=
ASSISTENTE_VOZ_ESTILO=
ASSISTENTE_VOZ_VELOCIDADE=
# Tom em semitons (precisa do ffmpeg; -1.5 = um pouco mais grave, sem mudar a velocidade). Vazio = sem ajuste.
ASSISTENTE_VOZ_TOM=
# Limite de caracteres por áudio (padrão 900, uns 45 s). A ElevenLabs cobra por caractere.
ASSISTENTE_VOZ_MAX=
# 0 = desliga a voz sem apagar a chave.
ASSISTENTE_VOZ=1
